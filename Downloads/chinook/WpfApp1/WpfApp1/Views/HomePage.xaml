<Page x:Class="WpfApp1.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp1.Views"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

	<Grid>
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
			<TextBlock Text="Welcome to the Chinook Music Store!"
                       FontSize="32"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

			<TextBlock Text="Your one-stop shop for great music"
                       FontSize="18"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>

			<TextBlock Text="Use the menu or toolbar to navigate to begin your musical journey"
                       FontSize="16"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>

			<Image Source="/Resources/music_logo.png" Width="200" Height="200" Margin="0,20,0,0"/>
		</StackPanel>
	</Grid>
</Page>