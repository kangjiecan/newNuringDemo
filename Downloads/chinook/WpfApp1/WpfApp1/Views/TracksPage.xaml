<Page x:Class="WpfApp1.Views.TracksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp1.Views"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TracksPage"
      Loaded="Page_Loaded">

	<Grid>
		<DockPanel>
			<TextBlock DockPanel.Dock="Top" Text="Chinook Tracks"
                       Style="{StaticResource PageHeaderStyle}"/>

			<!-- Using DataTemplate for tracks instead of GridView -->
			<ListView x:Name="TracksListView">
				<ListView.ItemTemplate>
					<DataTemplate>
						<Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0">
									<TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
									<StackPanel Orientation="Horizontal" Margin="0,5,0,0">
										<TextBlock Text="Composer: " FontStyle="Italic"/>
										<TextBlock Text="{Binding Composer}" Margin="5,0,0,0"/>
									</StackPanel>
									<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
										<TextBlock Text="Album: " FontStyle="Italic"/>
										<TextBlock Text="{Binding Album.Title}" Margin="5,0,0,0"/>
									</StackPanel>
									<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
										<TextBlock Text="Genre: " FontStyle="Italic"/>
										<TextBlock Text="{Binding Genre.Name}" Margin="5,0,0,0"/>
									</StackPanel>
								</StackPanel>

								<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
									<TextBlock>
										<Run Text="Length: "/>
										<Run Text="{Binding Milliseconds, StringFormat='{}{0:N0} ms'}"/>
									</TextBlock>
									<TextBlock>
										<Run Text="Size: "/>
										<Run Text="{Binding Bytes, StringFormat='{}{0:N0} bytes'}"/>
									</TextBlock>
									<TextBlock>
										<Run Text="Price: $"/>
										<Run Text="{Binding UnitPrice, StringFormat='{}{0:N2}'}"/>
									</TextBlock>
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</DockPanel>
	</Grid>
</Page>